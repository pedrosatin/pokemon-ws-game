{
  "name": "pokemon-ws-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.141.0"
  }
}
